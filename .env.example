# Required for live assistant requests; leave empty for catalog-only development.
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra

# Local and public-demo request protection defaults.
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_DAILY_REQUEST_LIMIT=50
CHAT_MAX_CONCURRENT_REQUESTS=2
CHAT_MAX_MESSAGE_CHARS=600
CHAT_MAX_BODY_BYTES=50000
OPENAI_MAX_CALLS_PER_DAY=120
OPENAI_MAX_OUTPUT_TOKENS=1600

# Optional locally; both are required for shared protection in Vercel Production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local SQLite defaults. Vercel automatically opens the build artifact read-only.
CATALOG_READ_ONLY=0
DATABASE_URL="file:./data/grocery-copilot.db"
